__pycache__/
*.py[cod]
.venv/
venv/
env/

# collectstatic output -- regenerated by build.sh on deploy
staticfiles/

# The local development database. Production uses DATABASE_URL (Postgres);
# a SQLite file must never be what a deployment relies on.
db.sqlite3

# Environment configuration and credentials. Nothing secret is committed:
# secrets come from the platform's own environment.
.env
.env.*
!.env.example

# TLS material, e.g. a self-signed cert for running the production-shaped
# server locally over HTTPS.
*.pem
*.key
*.crt

# Event exports and backups. Real participant data — keep it out of the repo.
*.csv
backup-*.sql
backup-*.sqlite3
