# Example environment. Copy to `.env` and fill in for a local
# production-shaped run, or use it as the checklist of what a deployment
# needs. `.env` is gitignored; this file carries no real value.
#
# On Render none of this is typed by hand: render.yaml generates the secrets
# and wires the connection strings across. See DEPLOYMENT.md.

# ---------------------------------------------------------------- required --

# Declares production. Every guard in settings.py keys off this and nothing
# is inferred from the platform. Leave unset (or "true") for development.
DJANGO_DEBUG=false

# Signs session cookies. The app refuses to boot in production with the
# development key that is published in this repository. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# The event itself. PostgreSQL in production -- the app refuses to start on
# SQLite with DEBUG off, because a hosted filesystem is erased on every deploy.
DATABASE_URL=postgres://user:password@host:5432/website_fixer

# The Channels layer, so a race handled by one worker reaches a scoreboard
# socket held by another. Required in production.
REDIS_URL=redis://host:6379

# The organiser's /admin/ password. `ensure_admin` refuses to create the
# account without one rather than inventing a guessable one.
WF_ADMIN_PASSWORD=

# Hostnames this server answers to, comma-separated. Not needed on Render,
# which supplies RENDER_EXTERNAL_HOSTNAME.
DJANGO_ALLOWED_HOSTS=192.168.1.20,fixer.local

# ---------------------------------------------------------------- optional --

# Origins allowed to POST. Only consulted over HTTPS, so a plain-HTTP LAN
# event needs nothing here. Include the scheme.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fixer.yourcollege.edu

# The organiser's login name. Defaults to admin123.
# WF_ADMIN_USERNAME=admin123

# Set false to run a production-shaped server over plain HTTP.
# DJANGO_SSL_REDIRECT=false

# Declares "one machine is running this whole event by itself", which permits
# SQLite and the in-memory channel layer with DEBUG off. This is the lab
# deployment in EVENT-OPERATIONS.md. NEVER set it on a hosted platform: it
# switches off the guard that stops the event living on a disk about to be
# erased.
# WF_SINGLE_MACHINE=true
